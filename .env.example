# Telegram bot token (required)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Claude authentication: Ari uses the Claude Code CLI (claude) which authenticates
# via its own login. Run 'claude login' once to authenticate; no API key needed.

# Recommended: Ari's own CLI login. Run `claude setup-token` once and paste the
# token here. Without it Ari uses your interactive login, and the CLI exposes
# that account's email inside Ari's context.
ARI_CLAUDE_OAUTH_TOKEN=

# Optional: path to the Claude Code CLI binary (defaults to 'claude')
# ARI_CLAUDE_BIN=claude
ARI_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Owners: comma-separated Telegram user ids. Owners approve access requests
# (/aprobar CODE) and can use coding mode. If empty, NOBODY can chat with Ari.
ARI_OWNER_IDS=

# Phase 2: Coding agent settings

# Sandbox root path for code modifications (defaults to current directory)
# ARI_ALLOWED_ROOT=.

# Model for the coding agent (defaults to Claude Sonnet)
# ARI_CODER_MODEL=claude-sonnet-4-6

# Timeout in seconds for coding operations (defaults to 900 = 15 minutes)
# ARI_CODING_TIMEOUT_SECONDS=900

# Proactivity
# ARI_TIMEZONE=America/Guayaquil
# ARI_QUIET_HOURS=22-7
# ARI_HEARTBEAT_MINUTES=60
# ARI_MAX_ITEMS_PER_USER=20

# Tools / MCP (see mcp/servers.json)
# ARI_CHAT_TIMEOUT_SECONDS=180
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# ARI_MYSQL_HOST=
# ARI_MYSQL_USER=
# ARI_MYSQL_PASS=
# ARI_MYSQL_DB=
