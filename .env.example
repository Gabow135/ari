# ─────────────────────────────────────────────────────────────────────────────
# Ari configuration. Copy to .env and fill in. Every variable is read with the
# ARI_ prefix (except TELEGRAM_BOT_TOKEN). Commented lines show the default —
# uncomment only what you want to override. Required vars are uncommented.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Owners: comma-separated Telegram user ids. Owners approve access requests
# (/aprobar CODE) and can use coding + WhatsApp. If empty, NOBODY can chat.
ARI_OWNER_IDS=

# ── Claude authentication ────────────────────────────────────────────────────
# Ari uses the Claude Code CLI (`claude`), which authenticates via its own login.
# Recommended: run `claude setup-token` once and paste the token here. Without it
# Ari uses your interactive login and the CLI exposes that account's email.
ARI_CLAUDE_OAUTH_TOKEN=
# ARI_CLAUDE_BIN=claude
# ARI_CLAUDE_CONFIG_DIR=./.ari-claude

# ── Core model & memory ──────────────────────────────────────────────────────
# ARI_MODEL=claude-sonnet-4-6
# ARI_DB_PATH=./ari.db
# ARI_WORKING_MEMORY_SIZE=20
# ARI_RECALL_TOP_K=5
# ARI_SOUL_DIR=./soul
ARI_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── Coding agent ─────────────────────────────────────────────────────────────
# ARI_ALLOWED_ROOT=.
# ARI_CODER_MODEL=claude-sonnet-4-6
# ARI_CODING_TIMEOUT_SECONDS=900

# ── Proactivity ──────────────────────────────────────────────────────────────
# ARI_TIMEZONE=America/Guayaquil
# ARI_QUIET_HOURS=22-7          # local "start-end"; empty = no quiet hours
# ARI_HEARTBEAT_MINUTES=60      # 0 disables the heartbeat
# ARI_MAX_ITEMS_PER_USER=50

# ── Tools / MCP ──────────────────────────────────────────────────────────────
# ARI_MCP_CONFIG=./mcp/servers.json
# ARI_SKILLS_DIR=./skills
# ARI_WORKSPACES_DIR=~/.ari/workspaces
# ARI_CHAT_TIMEOUT_SECONDS=900
# ARI_MCP_STARTUP_TIMEOUT_SECONDS=20

# ── Concurrency ──────────────────────────────────────────────────────────────
# ARI_MAX_CONCURRENT_CHATS=8
# ARI_MAX_BACKGROUND_AGENTS=3

# ── Logging ──────────────────────────────────────────────────────────────────
# ARI_LOG_FILE=./logs/ari.log   # empty = console only
# ARI_LOG_LEVEL=INFO

# ── Secrets vault (needed for per-user email / encrypted secrets) ────────────
# Set a strong key to enable the encrypted vault; leave empty to disable it.
ARI_VAULT_KEY=
# ARI_VAULT_PATH=~/.ari/vault.enc
# ARI_VAULT_WEB_PORT=8765
# ARI_VAULT_WEB_TTL_MINUTES=10
# ARI_VAULT_WEB_BIND=0.0.0.0

# ── Recall ranking (advanced; sensible defaults) ─────────────────────────────
# ARI_CANDIDATE_MULTIPLIER=4
# ARI_DEDUP_SIMILARITY=0.98
# ARI_RANK_MIN_SIMILARITY=0.3
# ARI_RANK_SIMILARITY_WEIGHT=0.6
# ARI_RANK_RECENCY_WEIGHT=0.25
# ARI_RANK_IMPORTANCE_WEIGHT=0.15
# ARI_RANK_RECENCY_HALF_LIFE_DAYS=30.0

# ── Memory importance & decay (advanced) ─────────────────────────────────────
# ARI_REINFORCE_DELTA=0.1
# ARI_DECAY_FACTOR=0.9
# ARI_PRUNE_FLOOR=0.15
# ARI_PRUNE_MIN_AGE_DAYS=7
# ARI_CONSOLIDATE_INTERVAL_HOURS=6

# ── WhatsApp (personal, opt-in; unofficial multi-device via neonize) ─────────
# Install the extra first: pip install -e '.[whatsapp]' (run.sh does this).
# OFF by default. Reading/replying to your PERSONAL WhatsApp violates WhatsApp's
# ToS and carries a real ban risk — enable only if you accept that.
ARI_WHATSAPP_ENABLED=false
# Your number for the pairing code: country code + number, NO leading + or spaces
# (e.g. 59399XXXXXXX). Required when ARI_WHATSAPP_ENABLED=true.
ARI_WHATSAPP_NUMBER=
# ARI_WHATSAPP_SESSION_DIR=~/.ari/whatsapp
# ARI_WHATSAPP_SEND_MIN_DELAY_SECONDS=3

# ── MCP-server-specific credentials (consumed by servers in mcp/servers.json) ─
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# ARI_MYSQL_HOST=
# ARI_MYSQL_USER=
# ARI_MYSQL_PASS=
# ARI_MYSQL_DB=
