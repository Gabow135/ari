{
  "name": "groq_audio",
  "version": "0.1.0",
  "enabled": true,
  "owner_only": true,
  "description": "Transcribe voice notes and reply with voice via Groq.",
  "entrypoint": "skill.py",
  "factory": "build_skill",
  "required_secrets": [
    "GROQ_API_KEY"
  ],
  "optional_secrets": [
    "HUGGINGFACE_TOKEN"
  ],
  "hooks": [
    "inbound_transform",
    "outbound_transform"
  ],
  "config": {
    "stt_model": "whisper-large-v3-turbo",
    "tts_model": "canopylabs/orpheus-v1-english",
    "tts_voice": "troy",
    "reply_with_voice": true
  }
}