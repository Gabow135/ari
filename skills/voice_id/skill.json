{
  "name": "voice_id",
  "version": "0.2.0",
  "enabled": true,
  "owner_only": true,
  "priority": 10,
  "description": "Enroll and identify family voice profiles using pyannote.audio embeddings.",
  "entrypoint": "skill.py",
  "factory": "build_skill",
  "required_secrets": [],
  "optional_secrets": ["HUGGINGFACE_TOKEN", "GROQ_API_KEY"],
  "hooks": [
    "inbound_transform"
  ],
  "config": {
    "profiles_dir": "data/voice_profiles",
    "enroll_timeout": 300,
    "speaker_id_threshold": 0.7,
    "stt_model": "whisper-large-v3-turbo"
  }
}
