{
  "mcpServers": {
    "google": {
      "command": "uvx",
      "args": ["workspace-mcp==1.29.0", "--tools", "gmail", "calendar", "drive"],
      "env": {
        "GOOGLE_OAUTH_CLIENT_ID": "${GOOGLE_OAUTH_CLIENT_ID}",
        "GOOGLE_OAUTH_CLIENT_SECRET": "${GOOGLE_OAUTH_CLIENT_SECRET}"
      },
      "access": "owner",
      "description": "Gmail, Calendar y Drive del creador"
    },
    "mysql": {
      "command": "npx",
      "args": ["-y", "@benborla29/mcp-server-mysql@2.0.9"],
      "env": {
        "MYSQL_HOST": "${ARI_MYSQL_HOST}",
        "MYSQL_USER": "${ARI_MYSQL_USER}",
        "MYSQL_PASS": "${ARI_MYSQL_PASS}",
        "MYSQL_DB": "${ARI_MYSQL_DB}"
      },
      "access": "owner",
      "description": "Base de datos (solo lectura)"
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "${ARI_FS_ROOT}"],
      "guarded": true,
      "access": "owner",
      "description": "Archivos del computador (carpeta de trabajo del dueño)"
    },
    "email": {
      "command": "npx",
      "args": ["-y", "mcp-mail-server@2.1.0"],
      "env": {
        "IMAP_HOST": "${ARI_IMAP_HOST}",
        "IMAP_PORT": "993",
        "IMAP_SECURE": "true",
        "SMTP_HOST": "${ARI_SMTP_HOST}",
        "SMTP_PORT": "465",
        "SMTP_SECURE": "true",
        "EMAIL_USER": "${ARI_EMAIL_USER}",
        "EMAIL_PASS": "${ARI_EMAIL_PASS}"
      },
      "access": "owner",
      "description": "Correo por IMAP/SMTP: leer y enviar (cuenta del creador)"
    },
    "huggingface": {
      "env": {
        "HUGGINGFACE_TOKEN": "${HUGGINGFACE_TOKEN}"
      },
      "access": "owner",
      "description": "Token de acceso a HuggingFace (requerido para voice_id / pyannote.audio)"
    }
  }
}
